# =========================================================================
# Apache Configuration for EduMath TBS App (ByetHost, cPanel, Apache Hosts)
# =========================================================================

# 1. Enable UTF-8 Encoding for all web assets
AddDefaultCharset UTF-8
AddType text/html;charset=utf-8 .html .htm
AddType text/css;charset=utf-8 .css
AddType application/javascript;charset=utf-8 .js
AddType application/json;charset=utf-8 .json
AddType image/svg+xml .svg .svgz
AddType image/webp .webp
AddType audio/mpeg .mp3
AddType font/woff .woff
AddType font/woff2 .woff2

# 2. Set Default Entry Page
DirectoryIndex index.html index.htm

# 3. Disable Directory Browsing for Security
Options -Indexes

# 4. URL Rewriting & Clean URLs for SPA Routing (Teacher, Student, Whiteboard)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /teacher or /teacher/ to teacher.html
    RewriteRule ^teacher/?$ teacher.html [L,QSA]

    # Redirect /student or /student/ to student.html
    RewriteRule ^student/?$ student.html [L,QSA]

    # Redirect /whiteboard or /bang_trang or /bang-trang to bang_trang.html
    RewriteRule ^(whiteboard|bang_trang|bang-trang)/?$ bang_trang.html [L,QSA]

    # Fallback to existing file/directory, otherwise send clean html if exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L,QSA]
</IfModule>

# 5. Enable Gzip / Deflate Compression (if supported)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml
</IfModule>

# 6. Leverage Browser Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 7. Cross-Origin Resource Sharing (CORS) for Fonts, Audio & Web Assets
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js|mp3|png|jpg|webp|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
