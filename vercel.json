{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/teacher", "destination": "/teacher.html" },
    { "source": "/student", "destination": "/student.html" },
    { "source": "/whiteboard", "destination": "/bang_trang.html" },
    { "source": "/bang-trang", "destination": "/bang_trang.html" },
    { "source": "/bang_trang", "destination": "/bang_trang.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
